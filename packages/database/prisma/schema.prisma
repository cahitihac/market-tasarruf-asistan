generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ReviewState {
  UNMATCHED
  AUTO_MATCHED
  NEEDS_REVIEW
  APPROVED
  REJECTED
}

enum RunStatus {
  RUNNING
  SUCCEEDED
  FAILED
  PARTIAL
}

enum PriceSourceType {
  DEMO_SEED
  CSV
  JSON
  OPEN_PRICES
  BROCHURE
}

enum DataSourceOperationalStatus {
  IDLE
  RUNNING
  PAUSED
  DISABLED
  STALE
  FAILING
}

enum OperationalAlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum OperationalAlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum DataSourceOnboardingStatus {
  PROPOSED
  DOCUMENTATION_PENDING
  AUTHORIZATION_PENDING
  TECHNICAL_REVIEW
  READY_FOR_TEST
  APPROVED
  REJECTED
  SUSPENDED
}

enum BrochureStatus {
  IMPORTED
  EXTRACTED
  REVIEW_REQUIRED
  PROCESSED
  DUPLICATE
  FAILED
}

enum MatchingReviewState {
  PENDING
  APPROVED
  REJECTED
  MATCHED
}

enum SourceAuthorizationStatus {
  AUTHORIZED
  PUBLIC_DATA
  MANUAL_UPLOAD
  UNVERIFIED
  RESTRICTED
}

enum AdminRole {
  ADMIN
  REVIEWER
  VIEWER
}

enum VerificationStatus {
  DEMO
  SUPPLIED_UNVERIFIED
  VERIFIED
}

enum IngestionRowStatus {
  MATCHED
  UNMATCHED
  DUPLICATE
  FAILED
}

enum DealLabel {
  BAD_PRICE
  NORMAL_PRICE
  GOOD_PRICE
  BUY
  GREAT_DEAL
}

enum DealStatus {
  ACTIVE
  EXPIRED
  SUPERSEDED
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum ConsumerAccountTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum PushPlatform {
  IOS
  ANDROID
  WEB
  UNKNOWN
}

enum NotificationDeliveryChannel {
  PUSH
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  FAILED
  INVALID_TOKEN
  SKIPPED
}

model User {
  id            String @id @default(cuid())
  email         String @unique
  passwordHash  String?
  displayName   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  status        UserStatus @default(ACTIVE)
  lastLoginAt   DateTime?
  emailVerifiedAt DateTime?
  deletedAt     DateTime?
  needs         UserNeed[]
  locations     UserLocation[]
  preferences   UserProductPreference[]
  recommendations Recommendation[]
  alerts        Alert[]
  notifications Notification[]
  pushDevices   PushDevice[]
  notificationPreference NotificationPreference?
  deals         Deal[]
  sessions      ConsumerSession[]
  accountTokens ConsumerAccountToken[]
}

model ConsumerSession {
  id          String @id @default(cuid())
  userId      String
  tokenHash   String @unique
  createdAt   DateTime @default(now())
  lastUsedAt  DateTime @default(now())
  expiresAt   DateTime
  revokedAt   DateTime?
  clientLabel String?
  ipAddress   String?
  user        User @relation(fields: [userId], references: [id])
  @@index([userId, expiresAt])
}

model ConsumerAccountToken {
  id        String @id @default(cuid())
  userId    String
  purpose   ConsumerAccountTokenPurpose
  tokenHash String @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
  usedAt    DateTime?
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, purpose, expiresAt])
}

model AdminUser {
  id           String @id @default(cuid())
  email        String @unique
  displayName  String?
  role         AdminRole @default(VIEWER)
  passwordHash String
  active       Boolean @default(true)
  createdAt    DateTime @default(now())
  sessions     AdminSession[]
  auditLogs    AdminAuditLog[]
  reviewEvents ReviewEvent[]
  ingestionReviewEvents IngestionReviewEvent[]
  dataSourceApprovalEvents DataSourceApprovalEvent[]
}

model AdminSession {
  id        String @id @default(cuid())
  userId    String
  tokenHash String @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  user      AdminUser @relation(fields: [userId], references: [id])
  @@index([userId, expiresAt])
}

model AdminAuditLog {
  id             String @id @default(cuid())
  actorId        String?
  action         String
  entityType     String
  entityId       String
  beforeSnapshot Json?
  afterSnapshot  Json?
  reason         String?
  requestId      String?
  metadata       Json @default("{}")
  createdAt      DateTime @default(now())
  actor          AdminUser? @relation(fields: [actorId], references: [id])
  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

model StoreChain {
  id               String @id @default(cuid())
  slug             String @unique
  name             String
  branches         StoreBranch[]
  retailerProducts RetailerProduct[]
  promotions       Promotion[]
  brochures        Brochure[]
}

model StoreBranch {
  id               String @id @default(cuid())
  chainId          String
  externalId       String?
  name             String
  city             String?
  latitude         Float?
  longitude        Float?
  chain            StoreChain @relation(fields: [chainId], references: [id])
  observations     PriceObservation[]
  deals            Deal[]
  @@unique([chainId, externalId])
}

model Category {
  id       String @id @default(cuid())
  slug     String @unique
  name     String
  products Product[]
  needs    UserNeed[]
}

model Brand {
  id       String @id @default(cuid())
  slug     String @unique
  name     String
  products Product[]
  preferences UserProductPreference[]
}

model Product {
  id             String @id @default(cuid())
  name           String
  normalizedName String
  ean            String? @unique
  categoryId     String
  brandId        String?
  category       Category @relation(fields: [categoryId], references: [id])
  brand          Brand? @relation(fields: [brandId], references: [id])
  variants       ProductVariant[]
  deals          Deal[]
  @@index([normalizedName])
}

model ProductVariant {
  id               String @id @default(cuid())
  productId        String
  label            String
  quantity         Int
  unit             String
  packageCount     Int @default(1)
  product          Product @relation(fields: [productId], references: [id])
  retailerProducts RetailerProduct[]
  @@unique([productId, quantity, unit, packageCount])
}

model RetailerProduct {
  id               String @id @default(cuid())
  chainId          String
  externalId       String
  rawName          String
  normalizedName   String
  ean              String?
  variantId        String?
  matchConfidence  Float?
  reviewState      ReviewState @default(UNMATCHED)
  chain            StoreChain @relation(fields: [chainId], references: [id])
  variant          ProductVariant? @relation(fields: [variantId], references: [id])
  observations     PriceObservation[]
  histories        PriceHistory[]
  promotions       Promotion[]
  brochureOffers   BrochureOffer[]
  deals            Deal[]
  ingestionRows    IngestionRow[]
  @@unique([chainId, externalId])
  @@index([variantId])
}

model PriceObservation {
  id                String @id @default(cuid())
  sourceKey         String @unique
  retailerProductId String
  branchId          String?
  promotionId       String?
  observedAt        DateTime
  priceMinor        Int
  regularPriceMinor Int?
  currency          String @default("TRY")
  sourceType        PriceSourceType @default(DEMO_SEED)
  sourceName        String @default("Demo seed")
  sourceIdentifier  String?
  sourceUrl         String?
  externalProductId String?
  retrievedAt       DateTime @default(now())
  rawPayloadRef     String?
  ingestionRunId    String?
  brochureOfferId   String? @unique
  confidence        Float?
  verificationStatus VerificationStatus @default(DEMO)
  retailerProduct   RetailerProduct @relation(fields: [retailerProductId], references: [id])
  branch            StoreBranch? @relation(fields: [branchId], references: [id])
  promotion         Promotion? @relation(fields: [promotionId], references: [id])
  deals             Deal[]
  ingestionRun      IngestionRun? @relation(fields: [ingestionRunId], references: [id])
  brochureOffer     BrochureOffer? @relation(fields: [brochureOfferId], references: [id])
  ingestionRows     IngestionRow[]
  @@index([retailerProductId, observedAt])
  @@index([branchId, observedAt])
  @@index([ingestionRunId])
}

model PriceHistory {
  id                String @id @default(cuid())
  retailerProductId String
  day               DateTime @db.Date
  minPriceMinor     Int
  maxPriceMinor     Int
  sumPriceMinor     BigInt
  observationCount  Int
  currency          String @default("TRY")
  retailerProduct   RetailerProduct @relation(fields: [retailerProductId], references: [id])
  @@unique([retailerProductId, day, currency])
}

model Promotion {
  id                String @id @default(cuid())
  chainId           String
  retailerProductId String?
  brochureOfferId   String? @unique
  title             String
  rawText           String?
  promotionKind     String @default("SIMPLE_SALE")
  percentDiscount   Int?
  multiBuyQuantity  Int?
  multiBuyPayQuantity Int?
  thresholdQuantity Int?
  thresholdUnit     String?
  startsAt          DateTime
  endsAt            DateTime
  loyaltyRequired   Boolean @default(false)
  chain             StoreChain @relation(fields: [chainId], references: [id])
  retailerProduct   RetailerProduct? @relation(fields: [retailerProductId], references: [id])
  brochureOffer     BrochureOffer? @relation(fields: [brochureOfferId], references: [id])
  conditions        PromotionCondition[]
  observations      PriceObservation[]
}

model PromotionCondition {
  id          String @id @default(cuid())
  promotionId String
  kind        String
  value       Json
  promotion   Promotion @relation(fields: [promotionId], references: [id])
}

model UserLocation {
  id        String @id @default(cuid())
  userId    String
  label     String
  latitude  Float
  longitude Float
  user      User @relation(fields: [userId], references: [id])
}

model UserNeed {
  id                   String @id @default(cuid())
  userId               String
  title                String
  categoryId           String?
  constraints          Json @default("{}")
  active               Boolean @default(true)
  createdAt            DateTime @default(now())
  user                 User @relation(fields: [userId], references: [id])
  category             Category? @relation(fields: [categoryId], references: [id])
  preferences          UserProductPreference[]
  recommendations      Recommendation[]
  alerts               Alert[]
  deals                Deal[]
  @@index([userId, active])
}

model UserProductPreference {
  id        String @id @default(cuid())
  userId    String
  needId    String?
  brandId   String?
  kind      String
  user      User @relation(fields: [userId], references: [id])
  need      UserNeed? @relation(fields: [needId], references: [id])
  brand     Brand? @relation(fields: [brandId], references: [id])
}

model Deal {
  id                 String @id @default(cuid())
  snapshotKey        String @unique
  userId             String
  needId             String
  canonicalProductId String
  retailerProductId  String
  branchId           String?
  observationId      String
  productName        String
  retailerName       String
  branchName         String?
  currentPriceMinor  Int
  unitPriceMinor     Int
  unitBasis          String
  currency           String @default("TRY")
  matchScore         Int
  score              Int
  label              DealLabel
  action             String
  reasons            Json
  matchReasons       Json
  priceStatistics    Json
  observedAt         DateTime
  evaluatedAt        DateTime @default(now())
  status             DealStatus @default(ACTIVE)
  user               User @relation(fields: [userId], references: [id])
  need               UserNeed @relation(fields: [needId], references: [id])
  canonicalProduct   Product @relation(fields: [canonicalProductId], references: [id])
  retailerProduct    RetailerProduct @relation(fields: [retailerProductId], references: [id])
  branch             StoreBranch? @relation(fields: [branchId], references: [id])
  observation        PriceObservation @relation(fields: [observationId], references: [id])
  recommendations    Recommendation[]
  alerts             Alert[]
  @@index([userId, status, evaluatedAt])
  @@index([needId, retailerProductId, branchId, status])
}

model Recommendation {
  id        String @id @default(cuid())
  userId    String
  needId    String
  dealId    String
  action    String
  createdAt DateTime @default(now())
  user      User @relation(fields: [userId], references: [id])
  need      UserNeed @relation(fields: [needId], references: [id])
  deal      Deal @relation(fields: [dealId], references: [id])
}

model Alert {
  id          String @id @default(cuid())
  dedupeKey   String @unique
  userId      String
  needId      String
  dealId      String
  createdAt   DateTime @default(now())
  user        User @relation(fields: [userId], references: [id])
  need        UserNeed @relation(fields: [needId], references: [id])
  deal        Deal @relation(fields: [dealId], references: [id])
  notification Notification?
  @@index([userId, createdAt])
}

model Notification {
  id        String @id @default(cuid())
  userId    String
  alertId   String @unique
  type      String @default("DEAL_ALERT")
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime @default(now())
  user      User @relation(fields: [userId], references: [id])
  alert     Alert @relation(fields: [alertId], references: [id])
  deliveries NotificationDelivery[]
  @@index([userId, createdAt])
}

model PushDevice {
  id            String @id @default(cuid())
  userId        String
  sessionId     String?
  expoPushToken String @unique
  platform      PushPlatform @default(UNKNOWN)
  deviceName    String?
  appVersion    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastSeenAt    DateTime @default(now())
  disabledAt    DateTime?
  lastDeliveryAt DateTime?
  user          User @relation(fields: [userId], references: [id])
  deliveries    NotificationDelivery[]
  @@index([userId, disabledAt])
  @@index([sessionId])
}

model NotificationPreference {
  userId              String @id
  dealAlertsEnabled   Boolean @default(false)
  greatDealEnabled    Boolean @default(false)
  buyEnabled          Boolean @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NotificationDelivery {
  id                String @id @default(cuid())
  notificationId    String
  pushDeviceId      String
  channel           NotificationDeliveryChannel @default(PUSH)
  status            NotificationDeliveryStatus @default(PENDING)
  attemptCount      Int @default(0)
  providerMessageId String?
  lastError         String?
  sentAt            DateTime?
  deliveredAt       DateTime?
  failedAt          DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  notification      Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  pushDevice        PushDevice @relation(fields: [pushDeviceId], references: [id])
  @@unique([notificationId, pushDeviceId, channel])
  @@index([status, createdAt])
  @@index([pushDeviceId, status])
}

model EvaluationRun {
  id                       String @id @default(cuid())
  status                   RunStatus @default(RUNNING)
  startedAt                DateTime @default(now())
  finishedAt               DateTime?
  activeNeedsEvaluated     Int @default(0)
  matchingProductsFound    Int @default(0)
  dealsCreated             Int @default(0)
  dealsUpdated             Int @default(0)
  alertsCreated            Int @default(0)
  notificationsCreated     Int @default(0)
  failureCount             Int @default(0)
  errors                   Json @default("[]")
}

model IngestionRun {
  id             String @id @default(cuid())
  dataSourceId   String?
  source         String
  sourceType     PriceSourceType @default(JSON)
  sourceIdentifier String?
  sourceUrl      String?
  checksum       String?
  trigger        String @default("MANUAL")
  jobId          String?
  attempt        Int @default(1)
  status         RunStatus @default(RUNNING)
  startedAt      DateTime @default(now())
  finishedAt     DateTime?
  processedCount Int @default(0)
  successCount   Int @default(0)
  matchedCount   Int @default(0)
  unmatchedCount Int @default(0)
  rowCount       Int @default(0)
  createdProductsCount Int @default(0)
  updatedProductsCount Int @default(0)
  observationsCreatedCount Int @default(0)
  duplicatesSkippedCount Int @default(0)
  promotionsCreatedCount Int @default(0)
  failureCount   Int @default(0)
  errors         Json @default("[]")
  dataSource     DataSource? @relation(fields: [dataSourceId], references: [id])
  observations   PriceObservation[]
  rows           IngestionRow[]
  @@index([dataSourceId, startedAt])
  @@index([status, startedAt])
}

model DataSource {
  id                    String @id @default(cuid())
  slug                  String @unique
  name                  String
  owner                 String?
  ownerContact          String?
  connectorType         PriceSourceType
  authorizationStatus   SourceAuthorizationStatus @default(UNVERIFIED)
  permittedCommercialUse Boolean @default(false)
  allowedDataRetentionDays Int?
  geographicCoverage    Json @default("{}")
  credentialRequirements String?
  feedSpecificationUrl  String?
  feedSpecification     Json @default("{}")
  onboardingStatus      DataSourceOnboardingStatus @default(PROPOSED)
  enabled               Boolean @default(false)
  scheduleEveryMs       Int?
  freshnessHours        Int @default(72)
  rateLimitPerMinute    Int?
  timeoutMs             Int @default(30000)
  maxAttempts           Int @default(3)
  config                Json @default("{}")
  fictional             Boolean @default(false)
  notes                 String?
  operationalStatus     DataSourceOperationalStatus @default(DISABLED)
  lastRunAt             DateTime?
  lastSuccessfulRunAt   DateTime?
  lastRunStatus         RunStatus?
  lastRunId             String?
  lastRecordCount       Int?
  lastFailureMessage    String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  ingestionRuns         IngestionRun[]
  operationalAlerts     OperationalAlert[]
  approvalEvents        DataSourceApprovalEvent[]
  @@index([enabled, authorizationStatus])
  @@index([onboardingStatus, authorizationStatus])
  @@index([operationalStatus, updatedAt])
}

model DataSourceApprovalEvent {
  id           String @id @default(cuid())
  dataSourceId String
  actorId      String?
  fromStatus   DataSourceOnboardingStatus?
  toStatus     DataSourceOnboardingStatus
  authorizationStatus SourceAuthorizationStatus?
  note         String?
  metadata     Json @default("{}")
  createdAt    DateTime @default(now())
  dataSource   DataSource @relation(fields: [dataSourceId], references: [id])
  actor        AdminUser? @relation(fields: [actorId], references: [id])
  @@index([dataSourceId, createdAt])
  @@index([actorId, createdAt])
}

model OperationalAlert {
  id           String @id @default(cuid())
  dedupeKey    String @unique
  dataSourceId String?
  severity     OperationalAlertSeverity @default(WARNING)
  status       OperationalAlertStatus @default(OPEN)
  kind         String
  title        String
  message      String
  metadata     Json @default("{}")
  lastExternalSentAt DateTime?
  externalSendCount Int @default(0)
  externalLastError String?
  firstSeenAt  DateTime @default(now())
  lastSeenAt   DateTime @default(now())
  resolvedAt   DateTime?
  dataSource   DataSource? @relation(fields: [dataSourceId], references: [id])
  @@index([status, severity, lastSeenAt])
  @@index([dataSourceId, status])
}

model IngestionRow {
  id                String @id @default(cuid())
  runId             String
  rowNumber         Int
  status            IngestionRowStatus
  rawPayloadHash    String
  rawPayload        Json?
  reason            String?
  retailerProductId String?
  observationId     String?
  run               IngestionRun @relation(fields: [runId], references: [id])
  retailerProduct   RetailerProduct? @relation(fields: [retailerProductId], references: [id])
  observation       PriceObservation? @relation(fields: [observationId], references: [id])
  ingestionReviewItem IngestionReviewItem?
  @@unique([runId, rowNumber])
  @@index([status, runId])
}

model IngestionReviewItem {
  id                String @id @default(cuid())
  ingestionRowId    String @unique
  state             MatchingReviewState @default(PENDING)
  rawValues         Json
  proposedValues    Json?
  candidateMatches  Json @default("[]")
  reason            String
  selectedVariantId String?
  createdAt         DateTime @default(now())
  resolvedAt        DateTime?
  ingestionRow      IngestionRow @relation(fields: [ingestionRowId], references: [id])
  events            IngestionReviewEvent[]
  @@index([state, createdAt])
}

model IngestionReviewEvent {
  id                    String @id @default(cuid())
  ingestionReviewItemId String
  actorId               String?
  action                String
  fromState             MatchingReviewState?
  toState               MatchingReviewState?
  note                  String?
  metadata              Json @default("{}")
  createdAt             DateTime @default(now())
  ingestionReviewItem   IngestionReviewItem @relation(fields: [ingestionReviewItemId], references: [id])
  actor                 AdminUser? @relation(fields: [actorId], references: [id])
  @@index([ingestionReviewItemId, createdAt])
  @@index([actorId, createdAt])
}

model Brochure {
  id               String @id @default(cuid())
  chainId          String
  source           String
  sourceIdentifier String
  sourceUrl        String?
  fileHash         String @unique
  sourceAuthorizationStatus SourceAuthorizationStatus @default(MANUAL_UPLOAD)
  sourceOwner      String?
  allowedUsage     String?
  verificationPolicy String?
  sourceNotes      String?
  sourceEffectiveFrom DateTime?
  sourceEffectiveTo   DateTime?
  mediaType        String
  originalFilename String?
  validFrom        DateTime?
  validTo          DateTime?
  importedAt       DateTime @default(now())
  status           BrochureStatus @default(IMPORTED)
  extractionRaw    Json?
  reviewState      ReviewState @default(NEEDS_REVIEW)
  chain            StoreChain @relation(fields: [chainId], references: [id])
  pages            BrochurePage[]
  extractionRuns   ExtractionRun[]
  offers           BrochureOffer[]
  @@index([chainId, importedAt])
}

model BrochureOffer {
  id                 String @id @default(cuid())
  brochureId         String
  pageId             String?
  extractionRunId    String?
  retailerProductId  String?
  observationId      String?
  promotionId        String?
  sourceKey          String @unique
  sourceLocation     String?
  productName        String
  brand              String?
  ean                String?
  packageQuantity    Int?
  packageUnit        String?
  packageCount       Int @default(1)
  currentPriceMinor  Int?
  regularPriceMinor  Int?
  promotionText      String?
  loyaltyRequired    Boolean @default(false)
  multiBuyText       String?
  validFrom          DateTime?
  validTo            DateTime?
  rawExtraction      Json
  normalizedOutput   Json?
  confidence         Float?
  matchConfidence    Float?
  reviewState        ReviewState @default(NEEDS_REVIEW)
  reviewReason       String?
  createdAt          DateTime @default(now())
  brochure           Brochure @relation(fields: [brochureId], references: [id])
  page               BrochurePage? @relation(fields: [pageId], references: [id])
  extractionRun      ExtractionRun? @relation(fields: [extractionRunId], references: [id])
  retailerProduct    RetailerProduct? @relation(fields: [retailerProductId], references: [id])
  observation         PriceObservation?
  promotion          Promotion?
  reviewItems        ReviewItem[]
  @@index([brochureId, reviewState])
  @@index([retailerProductId])
}

model BrochurePage {
  id          String @id @default(cuid())
  brochureId  String
  pageNumber  Int
  contentHash String?
  textContent String?
  imageRef    String?
  previewFormat String?
  previewWidth  Int?
  previewHeight Int?
  previewGeneratedAt DateTime?
  rawMetadata Json @default("{}")
  brochure    Brochure @relation(fields: [brochureId], references: [id])
  offers      BrochureOffer[]
  @@unique([brochureId, pageNumber])
}

model ExtractionRun {
  id             String @id @default(cuid())
  brochureId     String
  provider       String
  model          String?
  configVersion  String?
  status         RunStatus @default(RUNNING)
  startedAt      DateTime @default(now())
  finishedAt     DateTime?
  processedCount Int @default(0)
  successCount   Int @default(0)
  reviewCount    Int @default(0)
  duplicateCount Int @default(0)
  failureCount   Int @default(0)
  rawInputRef     String?
  rawOutput       Json?
  errors          Json @default("[]")
  brochure        Brochure @relation(fields: [brochureId], references: [id])
  offers          BrochureOffer[]
  reviewItems     ReviewItem[]
  @@index([brochureId, startedAt])
}

model ReviewItem {
  id                String @id @default(cuid())
  brochureOfferId   String
  extractionRunId    String?
  state             MatchingReviewState @default(PENDING)
  rawValues         Json
  normalizedValues  Json?
  candidateMatches  Json @default("[]")
  confidence        Float?
  reason            String
  sourceLocation    String?
  selectedVariantId String?
  createdAt         DateTime @default(now())
  resolvedAt        DateTime?
  brochureOffer     BrochureOffer @relation(fields: [brochureOfferId], references: [id])
  extractionRun      ExtractionRun? @relation(fields: [extractionRunId], references: [id])
  events             ReviewEvent[]
  @@index([state, createdAt])
}

model ReviewEvent {
  id           String @id @default(cuid())
  reviewItemId String
  actorId      String?
  action       String
  fromState    MatchingReviewState?
  toState      MatchingReviewState?
  note         String?
  metadata     Json @default("{}")
  createdAt    DateTime @default(now())
  reviewItem   ReviewItem @relation(fields: [reviewItemId], references: [id])
  actor        AdminUser? @relation(fields: [actorId], references: [id])
  @@index([reviewItemId, createdAt])
  @@index([actorId, createdAt])
}
